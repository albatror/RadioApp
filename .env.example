# Copy to .env and adjust. .env is gitignored — never commit secrets.
# Vite exposes variables prefixed VITE_ to the client bundle:
# do NOT put sensitive keys (API keys, tokens) here — they would be visible in the browser.

# Override the AzuraCast "now playing" endpoint (public, no key needed)
# VITE_AZURACAST_API_URL=https://ethnafrika.org/api/nowplaying/ethnafrika

# Override the audio stream URL
# VITE_STREAM_URL=https://ethnafrika.org/listen/ethnafrika/radio.mp3
